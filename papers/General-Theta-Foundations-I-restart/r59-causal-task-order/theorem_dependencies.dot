digraph GeneralTheta {
 rankdir=LR;
 raw [label="Positive prepared causal kernels"];
 tests [label="Executable future tests"];
 quotient [label="Borel predictive quotient\ncompact positive-evidence patches"];
 acquired [label="Actually prepared law K0\nderived f,w and profile"];
 order [label="Raw task order\npositive matrix measure"];
 occupation [label="Actual-history comparison\neffort and defect occupation"];
 roles [label="Physical live/output roles"];
 center [label="Affine causal acquired-geometry\nresource transfer theorem",shape=box];
 geometry [label="Covering, small-ball mass\nstrata and zero-loss atom"];
 curves [label="Matching resource curves"];
 numerics [label="Finite primitives, pilot\ncalibration and counted guard"];
 morphism [label="Causal state/clock/task morphism"];
 joint [label="Same-task resource--resolution--risk law"];
 classical [label="Classical kernel realization"];
 quantum [label="Quantum instrument realization"];
 raw -> tests -> quotient;
 raw -> acquired; raw -> order;
 acquired -> occupation; roles -> center; occupation -> center; order -> center;
 acquired -> geometry; geometry -> curves; center -> curves;
 center -> classical; order -> classical;
 center -> quantum; order -> quantum;
 center -> numerics; center -> morphism;
 curves -> joint; numerics -> joint; morphism -> joint;
}
