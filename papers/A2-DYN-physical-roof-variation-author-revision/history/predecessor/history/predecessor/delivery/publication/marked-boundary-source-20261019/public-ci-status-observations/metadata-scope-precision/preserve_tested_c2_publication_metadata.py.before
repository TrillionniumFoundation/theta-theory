#!/usr/bin/env python3
"""Preserve the exact three metadata blobs at the actual tested C2 commit."""
from pathlib import Path
import hashlib
import json
import subprocess

root = Path('/workspace/scratch/b5cc344d4c8e/theta-theory')
article_path = 'papers/A2-DYN-marked-boundary-source-author-revision'
commit = 'efde9fa6c45e7835989b653622a9870e59027530'
out = root / article_path / 'delivery/publication/marked-boundary-source-20261019/metadata-at-tested-C2'
assert not out.exists()
out.mkdir(parents=True)
rows = []
for name in ('PUBLICATION_STATUS.json', 'PUBLICATION_RECEIPT.json', 'REMOTE_TRANSPORT_STATUS.md'):
    identity = commit + ':' + article_path + '/' + name
    data = subprocess.check_output(['git', 'show', identity], cwd=root)
    blob = subprocess.check_output(['git', 'rev-parse', identity], cwd=root).decode().strip()
    assert hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest() == blob
    assert (root / article_path / name).read_bytes() == data
    (out / name).write_bytes(data)
    rows.append({'path': name, 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest(), 'git_blob_sha': blob})
receipt = {'scope': 'Exact metadata at the actual C2 commit; its content records C1 facts and predates the current completed-CI evidence. No existing byte was overwritten.', 'commit': commit, 'article_tree': 'b4add0580cc8211223dfa57e6e618e2bf9546d09', 'files': rows}
(out / 'METADATA_IDENTITIES.json').write_bytes((json.dumps(receipt, indent=2) + '\n').encode())
print(json.dumps(receipt, indent=2))
